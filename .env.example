# =========================================
# BotPanel — Fichier de configuration
# Copier en .env et remplir toutes les valeurs
# =========================================

# --- Discord ---
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=000000000000000000
# ID du channel par defaut pour les notifications (si aucun channel n'est specifie)
DISCORD_DEFAULT_CHANNEL_ID=000000000000000000
# Channel dedie aux messages de monitoring (temperature, conso, etc.)
DISCORD_MONITORING_CHANNEL_ID=000000000000000000

# --- Home Assistant ---
HA_BASE_URL=http://192.168.0.11:8123
HA_TOKEN=your_long_lived_access_token_here

# --- API / Site web ---
API_HOST=0.0.0.0
API_PORT=8080
SITE_BASE_URL=https://botpanel.super-nono.cc

# --- Stockage ---
DATABASE_PATH=./data/botpanel.db

# --- Logs ---
LOG_LEVEL=INFO

# --- Cloudflare Access (facultatif ; configurable aussi dans Parametres) ---
# Nom d'equipe SEUL (ex. super-nono), pas l'URL complete.
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag de l'application Access
CF_ACCESS_AUD=
# Verifier la signature du badge Cloudflare (recommande : true)
CF_VERIFY_JWT=true
# Autoriser l'entree locale (mot de passe LAN / secours).
#   true  = entree LAN possible (mot de passe si active) + Cloudflare.
#   false = acces UNIQUEMENT via Cloudflare ; tout acces direct est refuse (403).
# (Configurable aussi dans Parametres -> Badge Cloudflare / Acces.)
ALLOW_LOCAL_LOGIN=true
# Mot de passe admin de PREMIERE INSTALL (secours local). S'il est renseigne et
# qu'aucun mot de passe n'existe encore, il est HASHE et enregistre une fois au
# demarrage. Ensuite, gere-le dans Parametres. Laisse vide pour tout faire via l'UI.
ADMIN_PASSWORD=

# --- Integration Home Assistant (cle API machine) ---
# Cle utilisee par le composant Home Assistant pour appeler /api/integration/*.
# Si vide, une cle est generee a la demande dans Parametres -> API / Integration.
INTEGRATION_API_KEY=
